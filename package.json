{
  "devDependencies": {
    "@types/node": "^22.15.21",
    "ts-add-js-extension": "^1.6.5",
    "typescript": "^5.7.3"
  },
  "type": "module",
  "scripts": {
    "install ninja-plugin": "npm install ./ninja_plugin && npm run build",
    "uninstall ninja-plugin": "npm run preuninstall && npm uninstall ninja-plugin && npm run build",
    "build": "rm -rf ./build && tsc && ts-add-js-extension --dir=build",
    "preuninstall": "node ninja_plugin/scripts/uninstall.js"
  }
}
